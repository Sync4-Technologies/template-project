# Template GitHub Actions — Memory Check
#
# Detecta PRs que tocam código de produção sem atualização correspondente
# em .claude/squad/project/ (DECISIONS_LOG, ARCHITECTURE, ADR, agent-memory).
#
# Por default: warning não-bloqueante (continue-on-error: true).
# Para endurecer: remover continue-on-error em Production Mode.
#
# Instalação:
#   cp ${CLAUDE_PLUGIN_ROOT}/template/ci/memory-check.yml.example .github/workflows/memory-check.yml

name: Memory Check (Squad Discipline)

on:
  pull_request:
    branches: [main]
    types: [opened, synchronize, reopened]

jobs:
  check-memory-update:
    runs-on: ubuntu-latest
    continue-on-error: true   # warning, não fail; remover em Production Mode rigoroso

    steps:
      - name: Checkout PR
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Detect production code changes
        id: code-changes
        run: |
          BASE_SHA="${{ github.event.pull_request.base.sha }}"
          HEAD_SHA="${{ github.event.pull_request.head.sha }}"

          # Padrões de paths considerados "código de produção"
          CODE_PATHS='^(src/|lib/|app/|backend/|frontend/|mobile/|api/|services/|domain/|adapters/|application/|infrastructure/)'

          CODE_CHANGED=$(git diff --name-only "$BASE_SHA" "$HEAD_SHA" | grep -E "$CODE_PATHS" | wc -l)
          echo "code_changed=$CODE_CHANGED" >> $GITHUB_OUTPUT

          if [ "$CODE_CHANGED" -gt 0 ]; then
            echo "Detected $CODE_CHANGED code files changed."
          else
            echo "No production code changes detected."
          fi

      - name: Detect memory updates
        id: memory-changes
        if: steps.code-changes.outputs.code_changed != '0'
        run: |
          BASE_SHA="${{ github.event.pull_request.base.sha }}"
          HEAD_SHA="${{ github.event.pull_request.head.sha }}"

          MEMORY_PATHS='\.claude/squad/project/(DECISIONS_LOG\.md|ARCHITECTURE\.md|ADR/|agent-memory/)'

          MEMORY_UPDATED=$(git diff --name-only "$BASE_SHA" "$HEAD_SHA" | grep -E "$MEMORY_PATHS" | wc -l)
          echo "memory_updated=$MEMORY_UPDATED" >> $GITHUB_OUTPUT

          if [ "$MEMORY_UPDATED" -gt 0 ]; then
            echo "Memory updates detected: $MEMORY_UPDATED files."
          else
            echo "No memory updates in this PR."
          fi

      - name: Comment on PR if memory not updated
        if: |
          steps.code-changes.outputs.code_changed != '0' &&
          steps.memory-changes.outputs.memory_updated == '0'
        uses: actions/github-script@v7
        with:
          script: |
            const body = `
            ## ⚠️ Squad Memory Reminder

            Este PR inclui mudanças em código de produção mas **não atualiza** arquivos de memória da squad:

            - \`.claude/squad/project/DECISIONS_LOG.md\`
            - \`.claude/squad/project/ARCHITECTURE.md\`
            - \`.claude/squad/project/ADR/\` (novo ADR)
            - \`.claude/squad/project/agent-memory/\` (skeleton de agente)

            ### Quando atualizar?

            - **DECISIONS_LOG.md** — decisão técnica relevante (escolha de lib, padrão, trade-off)
            - **ARCHITECTURE.md** — mudança estrutural (novo componente, mudança de fluxo)
            - **ADR específico do projeto** — decisão arquitetural significativa (ADR-NNN+)
            - **agent-memory/{agente}.md** — learning do agente que pode ajudar no futuro

            ### Quando NÃO precisa atualizar?

            - Bug fix sem implicação arquitetural
            - Refactor mecânico (renomeação, formatação)
            - Mudança trivial sem decisão

            Se este PR se enquadra em "não precisa atualizar", **prossiga** — este é apenas um lembrete.

            Para handoff multi-usuário, considere acionar \`/squad-handoff\` antes de mergear.

            ---
            *Squad Memory Check — workflow opt-in (${CLAUDE_PLUGIN_ROOT}/template/ci/memory-check.yml.example)*
            `;

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: body
            });

      - name: Success
        if: |
          steps.code-changes.outputs.code_changed == '0' ||
          steps.memory-changes.outputs.memory_updated != '0'
        run: echo "✅ Squad memory discipline OK"
