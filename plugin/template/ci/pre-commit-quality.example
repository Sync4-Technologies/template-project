#!/usr/bin/env bash
# pre-commit-quality — gate BLOQUEANTE de qualidade local (opt-in).
#
# Instalação:
#   cp ${CLAUDE_PLUGIN_ROOT}/template/ci/pre-commit-quality.example .githooks/pre-commit-quality
#   chmod +x .githooks/pre-commit-quality
#   # encadear no .githooks/pre-commit existente (ou: git config core.hooksPath .githooks)
#
# Roda format:check + lint + typecheck no repositório INTEIRO antes de todo commit.
# Elimina o padrão "push -> CI vermelho em gate determinístico -> fix -> push"
# (LESSONS_LEARNED Concilia §16/§20: 3+ ciclos de CI por erro 100% reproduzível local).
#
# Bypass consciente (emergência, nunca rotina): git commit --no-verify
#
# Ajuste os comandos à stack do projeto. Exemplos:
#   Node/pnpm:  pnpm format:check / pnpm lint / pnpm typecheck
#   Python:     ruff format --check . / ruff check . / mypy .
#   Go:         gofmt -l . / golangci-lint run / go vet ./...

set -euo pipefail

run_gate() {
  local name="$1"; shift
  echo "[pre-commit-quality] ${name}..."
  if ! "$@"; then
    echo ""
    echo "[pre-commit-quality] FALHOU: ${name}"
    echo "Corrija localmente antes de commitar. CI confirma qualidade, não a descobre."
    echo "Bypass consciente (emergência): git commit --no-verify"
    exit 1
  fi
}

# --- PRE-CHECK DE AMBIENTE (antes de qualquer gate) ---
# Gate que falha por ambiente errado nao mede qualidade — vira obstaculo, e obstaculo
# ensina o habito do --no-verify. Observado nos 3 projetos da squad no mesmo dia: Node
# fora do range de engines, node_modules incompleto, servico de teste no ar faltando.
# Aqui a mensagem diz O QUE fazer, em vez de morrer no meio com erro de package manager.
ambiente_ok=1
aviso_ambiente() { echo "[ambiente] $1"; ambiente_ok=0; }

cd "$(git rev-parse --show-toplevel)" || exit 1   # checar o REPO, nao o diretorio de chamada

if [ -f package.json ] && command -v node >/dev/null 2>&1; then
  # Range de engines.node vs node em uso (so o major).
  #
  # [!] RESPEITAR O OPERADOR — a primeira versao nao respeitava. Ela extraia o primeiro
  # numero do range e comparava por IGUALDADE: num projeto que pede ">=22", o v26 (que
  # SATISFAZ o range) abortava TODO push com "pede major 22", e a mensagem oferecia
  # --no-verify como saida. Um pre-check anti-obstaculo que virou o obstaculo e ainda
  # ensinou a burla. Caso real: trokey-franchising, 2026-07-29 (AM-46/AM-47).
  engines_node=$(sed -n 's/.*"node"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' package.json | head -1)
  req_major=$(printf '%s' "${engines_node}" | sed -n 's/[^0-9]*\([0-9]\{1,\}\).*/\1/p')
  # Teto explicito, quando o range e FECHADO (">=22.0.0 <23.0.0" — o caso que motivou o
  # pre-check original; v26 de fato nao serve ali).
  # `|| true` obrigatorio: sob `set -euo pipefail`, um grep/sed SEM match retorna nao-zero e
  # MATA o script em silencio — o gate sairia sem rodar nada e sem dizer por que, justamente
  # nos ranges sem teto (">=22"), que sao a maioria. Pego na execucao real do example (AM-46).
  upper_major=$(printf '%s' "${engines_node}" | sed -n 's/.*<=\{0,1\}[[:space:]]*\([0-9]\{1,\}\).*/\1/p' || true)
  upper_op=$(printf '%s' "${engines_node}" | grep -o '<=\{0,1\}' | head -1 || true)
  cur_major=$(node -v | sed 's/^v\([0-9]*\).*/\1/')

  if [ -n "${req_major}" ] && [ -n "${cur_major}" ]; then
    case "${engines_node}" in
      '>='*|'>'*)
        if [ "${cur_major}" -lt "${req_major}" ]; then
          aviso_ambiente "Node em uso: v${cur_major} · package.json pede ${engines_node}. Use \`nvm use ${req_major}\` (ou fnm/volta) e rode de novo."
        elif [ -n "${upper_major}" ] &&
             { { [ "${upper_op}" = "<" ]  && [ "${cur_major}" -ge "${upper_major}" ]; } ||
               { [ "${upper_op}" = "<=" ] && [ "${cur_major}" -gt "${upper_major}" ]; }; }; then
          aviso_ambiente "Node em uso: v${cur_major} · package.json pede ${engines_node} (passa do teto). Use \`nvm use ${req_major}\` (ou fnm/volta) e rode de novo."
        fi
        ;;
      *)
        # Major fixo — pin ("22", "22.x") e caret ("^22.1.0" = >=22.1.0 <23.0.0).
        if [ "${cur_major}" != "${req_major}" ]; then
          aviso_ambiente "Node em uso: v${cur_major} · package.json fixa ${engines_node}. Use \`nvm use ${req_major}\` (ou fnm/volta) e rode de novo."
        fi
        ;;
    esac
  fi
  if [ ! -d node_modules ]; then
    aviso_ambiente "node_modules ausente — rode \`pnpm install\` (ou npm/yarn) antes."
  fi
fi

if [ "${ambiente_ok}" -ne 1 ]; then
  echo ""
  echo "[pre-commit-quality] ABORTADO NO PRE-CHECK — ambiente, nao qualidade."
  echo "Corrija o ambiente acima e rode de novo; NAO use --no-verify para contornar"
  echo "(se o pre-check errou, o bug e dele — conserte o pre-check, nao pule o gate)."
  exit 1
fi

# --- CONFIGURAR PARA A STACK DO PROJETO ---
if [ -f package.json ]; then
  PKG="npm run"
  command -v pnpm >/dev/null 2>&1 && PKG="pnpm"
  run_gate "format:check" ${PKG} format:check
  run_gate "lint"         ${PKG} lint
  run_gate "typecheck"    ${PKG} typecheck
elif [ -f pyproject.toml ]; then
  run_gate "format:check" ruff format --check .
  run_gate "lint"         ruff check .
  command -v mypy >/dev/null 2>&1 && run_gate "typecheck" mypy .
else
  echo "[pre-commit-quality] Stack não detectada — configure os comandos neste hook."
  exit 1
fi

# Marcador pro push-gate do plugin: registra a árvore validada.
# Após o commit, HEAD^{tree} == esta árvore -> push liberado.
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo .git)
TREE=$(git write-tree 2>/dev/null || git rev-parse "HEAD^{tree}" 2>/dev/null || true)
[ -n "$TREE" ] && echo "$TREE" > "$GIT_DIR/squad-gate-ok"

echo "[pre-commit-quality] OK — gate determinístico verde."
